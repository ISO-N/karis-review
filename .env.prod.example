# PostgreSQL 生产数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# JWT 签名密钥，建议使用至少 64 位随机字符
JWT_SECRET=

# JWT 有效期，单位毫秒，默认 7 天
JWT_EXPIRATION=604800000

# 注册邀请码开关；true 时注册必须填写 AUTH_INVITE_CODE
AUTH_INVITE_ENABLED=false
# 启用邀请码时必填，建议使用足够长的随机字符串
AUTH_INVITE_CODE=

# SMTP 邮件（找回密码 / 注册邮箱验证码）
# 未配置 MAIL_SMTP_HOST 时后端只把验证码打印到日志（仅适合本地开发），生产必须配置
MAIL_SMTP_HOST=
# 常用 587（STARTTLS）或 465（SSL）
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# 发件人地址
MAIL_FROM=noreply@kariscode.top
# 本地 SOCKS5 代理（Resend 等境外 SMTP 服务在国内部署时使用）；直连则留空
MAIL_SMTP_SOCKS_HOST=
MAIL_SMTP_SOCKS_PORT=

# 后端宿主机监听端口
BACKEND_PORT=8080
# 私有 GHCR 镜像拉取凭据；公开镜像可留空
GHCR_USERNAME=
GHCR_TOKEN=

# ---- 可靠性基建（阶段一）----

# JWT 多密钥轮换（WP-8）：jwt.keys 为逗号分隔的 kid=secret 列表，
# 签发用 JWT_ACTIVE_KID 指定的密钥；轮换时旧密钥保留在列表中即可继续验签
JWT_ACTIVE_KID=legacy
# 示例：JWT_KEYS=legacy=<64位随机串>,k2=<另一64位随机串>
JWT_KEYS=

# 备份存储（WP-1/G1）：local（默认，需独立卷）或 s3（MinIO/OSS/COS）
BACKUP_STORAGE_TYPE=s3
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_BUCKET=karis-review-backups

# MinIO 对象存储凭据
MINIO_ROOT_USER=karis-review
MINIO_ROOT_PASSWORD=

# 可观测性（WP-3）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# 只读副本（读扩展，需 docker compose --profile replica up）
REPLICA_PASSWORD=

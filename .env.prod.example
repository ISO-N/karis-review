# PostgreSQL 生产数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# JWT 签名密钥，建议使用至少 64 位随机字符
JWT_SECRET=

# JWT 有效期，单位毫秒，默认 7 天
JWT_EXPIRATION=604800000

# 注册邀请码开关；true 时注册必须填写 AUTH_INVITE_CODE
AUTH_INVITE_ENABLED=false
# 启用邀请码时必填，建议使用足够长的随机字符串
AUTH_INVITE_CODE=

# SMTP 邮件（找回密码 / 注册邮箱验证码）
# 未配置 MAIL_SMTP_HOST 时后端只把验证码打印到日志（仅适合本地开发），生产必须配置
MAIL_SMTP_HOST=
# 常用 587（STARTTLS）或 465（SSL）
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# 发件人地址
MAIL_FROM=noreply@kariscode.top
# 本地 SOCKS5 代理（Resend 等境外 SMTP 服务在国内部署时使用）；直连则留空
MAIL_SMTP_SOCKS_HOST=
MAIL_SMTP_SOCKS_PORT=

# 后端宿主机监听端口
BACKEND_PORT=8080
# 私有 GHCR 镜像拉取凭据；公开镜像可留空
GHCR_USERNAME=
GHCR_TOKEN=
